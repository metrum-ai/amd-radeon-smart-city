# ============================================================
# Smart City Public Safety Platform — environment variables
# Copy to .env and fill in real values before running.
# ============================================================

# ------------------------------------------------------------
# TimescaleDB (PostgreSQL)
# ------------------------------------------------------------
# setup.sh fills the password and derived connection URL.
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=
POSTGRES_DB=smartcity_db
DATABASE_URL=

# ------------------------------------------------------------
# Milvus vector database
# ------------------------------------------------------------
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ------------------------------------------------------------
# RustFS object store (Milvus S3-compatible dependency)
# setup.sh fills both credentials. Both variables MUST be set;
# an empty value will leave RustFS with no credentials and Milvus init will fail.
# ------------------------------------------------------------
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ------------------------------------------------------------
# Embedding service (HuggingFace Text Embeddings Inference)
# Points to the vllm-embed container (internal port 8000, host port 8005).
# Leave empty to disable RAG embeddings.
# ------------------------------------------------------------
EMBED_BASE_URL=http://vllm-embed:8000
# HuggingFace model ID served by the TEI embedding container.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------
# LLM inference
# Default: local Lemonade server (llama.cpp / ROCm on GPU 1).
# The model is downloaded once into the lemonade-cache Docker volume
# and reused on every restart — no re-download required.
VLLM_BASE_URL=http://lemonade:13305
# Default LLM is the Qwen3-30B-A3B MoE (Unsloth UD-Q4_K_XL GGUF). Pulled into
# the lemonade-cache volume on first start (~17 GB download).
LLM_MODEL=user.Qwen3-30B-A3B-UD-Q4_K_XL
VLLM_SERVED_MODEL_NAME=user.Qwen3-30B-A3B-UD-Q4_K_XL
LEMONADE_MODEL=user.Qwen3-30B-A3B-UD-Q4_K_XL
# Upstream HF checkpoint that lemonade fetches when LEMONADE_MODEL is missing
# from its cache. Keep this paired with LEMONADE_MODEL above.
LEMONADE_CHECKPOINT=unsloth/Qwen3-30B-A3B-GGUF:UD-Q4_K_XL
# rocm: GPU 1 dedicated to LLM inference. HSA_OVERRIDE_GFX_VERSION required for gfx1201.
LEMONADE_LLAMACPP_BACKEND=rocm
# Logical GPU index inside the lemonade container (must be within ROCR_VISIBLE_DEVICES).
LEMONADE_GPU_ID=1
# Leave empty for local lemonade; set to your key to use OpenRouter instead:
LLM_API_KEY=
# HuggingFace token — OPTIONAL. Leave empty for public models like the default
# Qwen3-30B-A3B GGUF (downloads fine without auth). Set it only if you point
# LEMONADE_CHECKPOINT at a gated repo (Llama, Mistral, etc.) or hit rate limits.
HF_TOKEN=

# ------------------------------------------------------------
# AMD ROCm GPU configuration
# ROCR_VISIBLE_DEVICES: comma-separated GPU indices (e.g. 0,1 for two GPUs)
# HSA_OVERRIDE_GFX_VERSION: match your GPU family (e.g. 12.0.1 for RX 9000)
# YOLO_GPU_ID / DMCOUNT_GPU_ID: logical GPU index for YOLO and DM-Count within
# the pipeline container (must be within ROCR_VISIBLE_DEVICES range).
# ------------------------------------------------------------
SMARTCITY_GPU_PROFILE=2gpu
COMPOSE_FILE=docker-compose.yml:docker-compose.profile-2gpu.yml
ROCR_VISIBLE_DEVICES=0,1
HSA_VISIBLE_DEVICES=0,1
HSA_OVERRIDE_GFX_VERSION=12.0.1
GPU_COUNT=1
YOLO_GPU_ID=0
DMCOUNT_GPU_ID=1
YOLO_START_GPU=0
YOLO_REPLICAS_PER_GPU=2
DENSITY_PHYSICAL_GPU=1
# Host device group IDs. setup.sh resolves these from getent so ROCm
# containers can access /dev/kfd and /dev/dri across different hosts.
VIDEO_GID=44
RENDER_GID=109

# ------------------------------------------------------------
# Video analytics pipeline
# ------------------------------------------------------------
# Decode backend for incoming RTSP streams.
#   hardware  → VA-API (vaapih264dec) on the GPU specified by HW_DECODE_VAAPI_GPU.
#               Supported by the 4-GPU profile on kernel >= 6.17.
#   software  → libav software decode. Higher CPU, no GPU video block usage.
# setup.sh forces software on the 2-GPU profile because GPU 1 already runs
# DM-Count + Lemonade and has no stable VCN headroom.
DECODE_MODE=hardware
# Physical GPU index whose VCN video decoder VA-API binds to. The compose
# profile overrides this so VA-API never lands on a YOLO compute GPU:
#   2-gpu profile disables hardware decode and leaves this documented as GPU 1
#   4-gpu profile pins HW_DECODE_VAAPI_GPU=0 (YOLO on GPUs 1,2)
HW_DECODE_VAAPI_GPU=1
# Stagger VA-API context creation between stream workers (milliseconds).
# Avoids the amdgpu KMD hang that happens when many workers init VA-API
# simultaneously. 200 ms × N streams ≈ startup spread.
HW_DECODE_STAGGER_MS=200
# Optional cap on how many streams get hardware decode (the remainder go
# straight to software). Leave empty to let every stream try VA-API first.
# HW_DECODE_MAX_STREAMS=
#
# Encode backend for outbound RTSP streams. Stays on libx264 software in
# this release — hardware encode (h264_vaapi) is wired in but disabled by
# default because it adds VCN contention on the 2-GPU layout. Flip to
# "hardware" only if you have profiled VCN headroom.
ENCODE_MODE=software
# Number of physical AMD GPUs available to the pipeline container
NUM_GPUS=2
# Number of concurrent RTSP streams to process. setup.sh rewrites this default:
# <=64 physical CPU cores uses 25, >64 physical CPU cores uses 50.
STREAM_COUNT=25
# How many of those streams render a DM-Count density heatmap overlay.
# setup.sh keeps this equal to STREAM_COUNT unless explicitly overridden.
DENSITY_DISPLAY_STREAMS=25
# Path to pipeline stats JSON (shared Docker volume; do not change)
PIPELINE_STATS_FILE=/pipeline_stats/pipeline_stats.json
# RTSP base URL that the input publisher writes streams to.
INPUT_BASE_RTSP=rtsp://mediamtx:8554/cam
# MediaMTX hostname the pipeline connects to for RTSP/WebRTC. Override only
# if you run an external MediaMTX outside the compose network.
MEDIAMTX_HOST=mediamtx
# Set to 0 to push video as fast as possible (useful for testing).
REALTIME_INPUT=1

# ------------------------------------------------------------
# Simulator
# ------------------------------------------------------------
# Days of real data required before simulator data is retired
SIMULATE_RETIRE_AFTER_DAYS=7

# ------------------------------------------------------------
# RAG document ingestion
# Host path mounted into the api container at /app/data/docs.
# Supported file types: .txt, .md, .pdf
# ------------------------------------------------------------
DOCS_INGEST_PATH=./smart_city/docs/policy

# ------------------------------------------------------------
# RTSP camera streams (never put plaintext credentials in VCS)
# Add as many RTSP_CAM_{N}_URL entries as needed.
# ------------------------------------------------------------
RTSP_CAM1_URL=rtsp://user:pass@camera1.local:554/stream  # pragma: allowlist secret
RTSP_CAM2_URL=rtsp://user:pass@camera2.local:554/stream  # pragma: allowlist secret

# ------------------------------------------------------------
# Frontend gateway + WebRTC routing
# ------------------------------------------------------------
# Host port that maps to the frontend nginx container's port 80.
GATEWAY_HTTP_PORT=5173
# Comma-separated list of additional ICE candidate hosts that MediaMTX
# advertises to browsers. Add the server's LAN/public IP for any non-localhost
# clients. setup.sh auto-populates this with detected interface addresses.
PUBLIC_WEBRTC_HOSTS=127.0.0.1,localhost
# Path prefix where the API tells the SPA to find the WebRTC signaling
# endpoint (proxied by nginx to mediamtx).
SCRATCH_WEBRTC_BASE_URL=/webrtc

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
